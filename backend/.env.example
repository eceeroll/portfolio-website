# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/portfolio_db"

# Port the API listens on (Render injects this automatically)
PORT=3000

# Deployed frontend origin allowed by CORS (http://localhost:5173 is always allowed)
CLIENT_URL="https://eceerol.dev"

# Shared secret required in the `x-api-key` header for POST/PUT/DELETE /api/projects.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=""

# Resend API key and the inbox that receives contact form messages
RESEND_API_KEY=""
CONTACT_EMAIL="you@example.com"
